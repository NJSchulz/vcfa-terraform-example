# Terraform working directories
**/.terraform/*

# State files (state lives on the runner, never in the repo)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files may contain secrets
*.tfvars
*.tfvars.json

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc
